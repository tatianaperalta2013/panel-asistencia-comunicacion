# Copiar este archivo como .env y completar los valores

PORT=3000

# Direcciones de los servicios (en Render, las URL que te da cada servicio)
USUARIOS_URL=http://localhost:4001
STATUS_URL=http://localhost:4002

# La misma clave que en servicio-usuarios (se usa para validar el JWT)
JWT_SECRET=cambiar_por_una_clave_larga

# La misma clave que en los dos servicios
GATEWAY_SECRET=cambiar_por_otra_clave_larga

# Desde qué página se permite llamar a la API (la URL de Vercel).
# Se pueden poner varias separadas por coma. Vacío = cualquiera.
FRONTEND_URL=
