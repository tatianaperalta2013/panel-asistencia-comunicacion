# Copiar como .env y completar
PORT=3000
# URL de cada API (en Render, la que te da cada servicio)
USUARIOS_URL=http://localhost:4001
STATUS_URL=http://localhost:4002
# Igual que en servicio-usuarios
JWT_SECRET=cambiar_por_una_clave_larga
# Igual que en servicio-usuarios y servicio-status
GATEWAY_SECRET=cambiar_por_otra_clave_larga
# URL del frontend en Vercel (vacío = acepta cualquiera)
FRONTEND_URL=
