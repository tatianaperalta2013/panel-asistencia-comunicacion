# Copiar este archivo como .env y completar los valores

PORT=4002

# Conexión a MongoDB Atlas (una base distinta a la de usuarios).
# Si se deja vacío, los datos se guardan en memoria y se borran al reiniciar.
MONGO_URI=

# Tiene que ser EXACTAMENTE la misma clave en el gateway
GATEWAY_SECRET=cambiar_por_otra_clave_larga

# Dirección del frontend, para armar el link de la reunión
FRONTEND_URL=http://localhost:5500

# Cantidad mínima de participantes activos para mostrar el promedio.
# En la demo se puede bajar a 1 para probar con una sola persona.
MIN_PARTICIPANTES=3

# Segundos sin actividad para dejar de contar a un participante
SEGUNDOS_INACTIVIDAD=30
