# Copiar este archivo como .env y completar los valores

PORT=4001

# Conexión a MongoDB Atlas. Si se deja vacío, el servicio guarda los datos
# en memoria (sirve para probar en tu compu, pero se borran al reiniciar).
MONGO_URI=

# Tiene que ser EXACTAMENTE la misma clave en el gateway
JWT_SECRET=cambiar_por_una_clave_larga

# Tiene que ser EXACTAMENTE la misma clave en el gateway
GATEWAY_SECRET=cambiar_por_otra_clave_larga
