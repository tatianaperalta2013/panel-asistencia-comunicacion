@startuml 00-arquitectura-general
title Panel de Asistencia de Comunicación — Arquitectura general
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #333333

actor "Participante\n(navegador)" as user

package "CAPA DE PRESENTACIÓN (Frontend)" #E8F1FB {
  component "App web\nHTML + CSS + JavaScript\n(Vercel / Netlify)" as app
}

package "CAPA DE LÓGICA DE NEGOCIO (Backend — Node.js + Express)" #EAF7EA {
  component "API Gateway\n:3000\n- Punto único de entrada\n- Valida JWT\n- Agrega headers X-Usuario-*\n- Reenvía a cada servicio" as gw
  component "Servicio Usuarios\n:4001\n- Registro\n- Login (bcrypt + JWT)" as su
  component "Servicio Status\n:4002\n- Salas (reuniones)\n- Estados de los sliders\n- Promedio anónimo" as ss
}

package "CAPA DE ACCESO A DATOS (MongoDB Atlas)" #FDF2E3 {
  database "BDD Usuarios\ncolección: usuarios" as dbu
  database "BDD Status\ncolecciones: salas, estados" as dbs
}

user --> app : HTTPS
app --> gw : HTTP + JSON\nAuthorization: Bearer JWT
gw --> su : /api/auth/*
gw --> ss : /api/salas/*\n+ X-Usuario-Id
su --> dbu : Mongoose
ss --> dbs : Mongoose

note right of gw
  Patrones aplicados:
  • Cliente-servidor
  • Arquitectura en 3 capas
  • Microservicios + API Gateway
  • Base de datos por servicio
  • Capas internas: Rutas → Controlador
    → Servicio → Modelo (MVC sin vista)
end note

note bottom of ss
  Los servicios solo aceptan pedidos
  que vienen del Gateway.
  Nunca devuelven valores individuales:
  solo el promedio de la sala.
end note
@enduml
