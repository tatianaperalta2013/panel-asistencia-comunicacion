@startuml S7-salir-reunion
title S7 — Salir de la reunión (HU7)
skinparam defaultFontName Arial
skinparam shadowing false
autonumber

actor "Participante" as u
participant "App web" as app
participant "API Gateway" as gw
participant "Servicio Status" as ss
database "BDD Status" as db

u -> app : Toca "Back" en el Panel
app -> app : Detiene la consulta periódica (S6)
app -> gw : DELETE /api/salas/{codigo}/participantes/yo\nAuthorization: Bearer JWT
gw -> gw : verificarJWT()

alt JWT inválido o vencido
  gw --> app : 401 Unauthorized
  app --> u : Vuelve a Login
else JWT válido
  gw -> ss : DELETE /salas/{codigo}/participantes/yo\nX-Usuario-Id
  ss -> db : deleteOne({codigo, usuarioId})
  db --> ss : OK
  ss --> gw : 204 No Content
  gw --> app : 204 No Content
  app --> u : Vuelve a Home
end

note over app, db
  Si el participante cierra la pestaña sin tocar "Back",
  deja de enviar datos y a los 30 s ya no cuenta en el promedio (ver S6).
end note
@enduml
