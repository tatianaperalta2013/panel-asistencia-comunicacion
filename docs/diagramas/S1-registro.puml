@startuml S1-registro
title S1 — Registro de usuario (HU1)
skinparam defaultFontName Arial
skinparam shadowing false
autonumber

actor "Participante" as u
participant "App web" as app
participant "API Gateway" as gw
participant "Servicio Usuarios" as su
database "BDD Usuarios" as db

u -> app : Completa usuario, email\ny contraseña. Toca "Crear usuario"
app -> app : Valida campos\n(vacíos, email, contraseña ≥ 8)

alt Datos incompletos o inválidos
  app --> u : Muestra el error en el formulario
else Datos válidos
  app -> gw : POST /api/auth/registro\n{usuario, email, password}
  note right of gw : Ruta pública:\nno pide JWT
  gw -> su : POST /usuarios\n{usuario, email, password}
  su -> db : findOne({ $or: [usuario, email] })
  db --> su : resultado

  alt Usuario o email ya existe
    su --> gw : 409 Conflict {mensaje}
    gw --> app : 409 Conflict {mensaje}
    app --> u : "Ese usuario o email ya está registrado"
  else Es nuevo
    su -> su : passwordHash = bcrypt.hash(password)
    su -> db : insertOne({usuario, email, passwordHash})
    db --> su : {_id}
    su --> gw : 201 Created {id, usuario}
    gw --> app : 201 Created {id, usuario}
    app --> u : "Cuenta creada" y vuelve a Login
  end
end
@enduml
