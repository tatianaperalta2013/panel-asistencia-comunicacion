@startuml S5-enviar-estado
title S5 — Enviar mi estado de forma anónima (HU5)
skinparam defaultFontName Arial
skinparam shadowing false
autonumber

actor "Participante" as u
participant "App web" as app
participant "API Gateway" as gw
participant "Servicio Status" as ss
database "BDD Status" as db

u -> app : Mueve uno de los 4 sliders\n(Estrés, Perdido, Falta contexto, Devolución)
app -> app : Espera 500 ms sin cambios\n(evita mandar un pedido por cada pixel)
app -> gw : PUT /api/salas/{codigo}/estado\n{estres, perdido, faltaContexto, devolucion}\nAuthorization: Bearer JWT
gw -> gw : verificarJWT()

alt JWT inválido o vencido
  gw --> app : 401 Unauthorized
  app --> u : "Tu sesión venció" y vuelve a Login
else JWT válido
  gw -> ss : PUT /salas/{codigo}/estado {valores}\nX-Usuario-Id
  ss -> ss : Valida que cada valor esté entre 0 y 10

  alt Valores fuera de rango
    ss --> gw : 400 Bad Request
    gw --> app : 400 Bad Request
    app --> u : Vuelve el slider al último valor válido
  else Sala finalizada o el usuario no está en la sala
    ss --> gw : 403 Forbidden
    gw --> app : 403 Forbidden
    app --> u : "Ya no estás en esta reunión" y vuelve a Home
  else Todo OK
    ss -> db : updateOne({codigo, usuarioId},\n{valores, ultimaActividad: ahora}, upsert)
    alt Error en la BDD
      db --> ss : error
      ss --> gw : 500 Internal Server Error
      gw --> app : 500
      app --> u : "No se pudo guardar, reintentando…"
    else Guardado
      db --> ss : OK
      ss --> gw : 204 No Content
      gw --> app : 204 No Content
    end
  end
end

note over app, db
  El valor individual se guarda solo para poder actualizarlo.
  Ningún endpoint devuelve los valores de una persona.
end note
@enduml
