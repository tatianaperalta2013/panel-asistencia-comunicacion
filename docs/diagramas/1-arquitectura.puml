@startuml 1-arquitectura
title <size:20><b>PANEL DE ASISTENCIA DE COMUNICACIÓN</b></size>\nDiagrama de Arquitectura del Sistema Completo
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowThickness 1.5
skinparam rectangle {
  RoundCorner 14
  BorderColor #9AA5B1
}
skinparam database {
  BorderColor #8C6D3F
  BackgroundColor #FFF8EC
}
skinparam note {
  BackgroundColor #FBE3E4
  BorderColor #A6192E
  FontColor #7A0F1F
}

rectangle "<b>FRONTEND</b>\n<img:logos/vercel.png{scale=0.5}>" as front #EAF2FB {
  rectangle "<b>PANEL DE ASISTENCIA</b>\n<img:logos/html5.png{scale=0.5}> <img:logos/css.png{scale=0.5}> <img:logos/javascript.png{scale=0.5}>" as app #FFFFFF
}

rectangle "<b>BACKEND</b>                            <img:logos/render.png{scale=0.5}>" as back #EAF6EC {
  rectangle "<b>API GATEWAY</b>\n<img:logos/nodedotjs.png{scale=0.4}> <img:logos/express.png{scale=0.4}>" as gw #FFFFFF
  rectangle "<b>USUARIOS</b>\n<img:logos/nodedotjs.png{scale=0.4}> <img:logos/express.png{scale=0.4}>" as usu #FFFFFF
  rectangle "<b>STATUS</b>\n<img:logos/nodedotjs.png{scale=0.4}> <img:logos/express.png{scale=0.4}>" as sta #FFFFFF
}

rectangle "<b>BDD</b>\n<img:logos/mongodb.png{scale=0.5}>" as bdd #FDF4E6 {
  database "<b>BDD USUARIOS</b>\n<size:11>usuarios</size>" as dbu
  database "<b>BDD STATUS</b>\n<size:11>salas · valores · historial</size>" as dbs
}

app -[#2F6FB0,thickness=2]-> gw : <color:#2F6FB0><b>HTTP/REST + JWT</b></color>
gw -[#3C873A,thickness=2]-> usu : <color:#3C873A><b>HTTP/REST</b></color>\n<color:#3C873A><b>+ Custom Headers</b></color>
gw -[#3C873A,thickness=2]-> sta : <color:#3C873A><b>HTTP/REST</b></color>\n<color:#3C873A><b>+ Custom Headers</b></color>
usu -[#8C6D3F,thickness=2]-> dbu : <color:#8C6D3F><b>CONEXION A BDD</b></color>
sta -[#8C6D3F,thickness=2]-> dbs : <color:#8C6D3F><b>CONEXION A BDD</b></color>

note right of gw
  <b>API GATEWAY VALIDA JWT</b>
  <b>Y ENVIA LOS CUSTOM HEADERS</b>
  <b>HACIA APIS</b>
end note
@enduml
